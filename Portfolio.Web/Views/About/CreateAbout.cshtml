@model About
@{
    ViewData["Title"] = "Yeni Hakkımda Oluştur";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<h2>Yeni Hakkımda Oluştur</h2>

<form method="post" action="/About/CreateAbout">
    <div class="mb-3">
        <label>Resim URL</label>
        <input type="text" name="ImageURL" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Başlık</label>
        <input type="text" name="Title" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Açıklama</label>
        <textarea name="Description" class="form-control"></textarea>
    </div>
    <div class="mb-3">
        <label>Doğum Tarihi</label>
        <input type="date" name="BirthDate" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Website</label>
        <input type="text" name="WebSite" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Telefon Numarası</label>
        <input type="text" name="PhoneNumber" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Şehir</label>
        <input type="text" name="City" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Mezuniyet</label>
        <input type="text" name="Graduation" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Email</label>
        <input type="email" name="Email" class="form-control" />
    </div>
    <div class="mb-3 form-check">
        <input type="checkbox" name="IsAvailable" class="form-check-input" />
        <label class="form-check-label">Müsait mi?</label>
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a href="/About/Index" class="btn btn-secondary">Geri Dön</a>
</form>